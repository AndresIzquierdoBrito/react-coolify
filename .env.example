APP_ORIGIN=https://projects.izbri.com
OWNER_CONTACT_URL=https://izbri.com
SESSION_SECRET=replace-with-at-least-32-random-characters

# Coolify API base may include /api/v1. Use a read-only team token.
COOLIFY_API_URL=https://coolify.example.com
COOLIFY_API_KEY=token-id|token-secret
# Only for a private/self-signed CA: mount the CA PEM and point Node to its in-container path.
NODE_EXTRA_CA_CERTS=

# OAuth callback: https://projects.izbri.com/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ADMIN_LOGINS=your-github-login

# Temporary owner login. Use a long unique password and remove these when OAuth replaces it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Keep false unless private/internal health targets are intentional.
ALLOW_PRIVATE_MONITOR_TARGETS=false
LOG_LEVEL=info
